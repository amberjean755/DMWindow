<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Guess what's coming to Main Street | Dave &amp; Marbie's Cafe</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,600;1,500&family=Karla:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --espresso: #3B2419;
    --coffee: #6E4530;
    --coffee-soft: #8C5F44;
    --cream: #FBF3EA;
    --blush: #F3D2DC;
    --blush-deep: #EABBC9;
    --rose: #C97C93;
    --rose-deep: #B15E77;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--cream);
    color: var(--espresso);
  }

  body {
    font-family: 'Karla', sans-serif;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  main {
    width: 100%;
    max-width: 420px;
  }

  .screen {
    display: none;
  }

  .screen.active {
    display: block;
    animation: rise 0.5s ease both;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .screen.active { animation: none; }
  }

  .logo {
    display: block;
    width: 100%;
    max-width: 260px;
    height: auto;
    margin: 0 auto 2.25rem;
  }

  h1 {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(1.6rem, 6vw, 2.1rem);
    line-height: 1.25;
    text-align: center;
    margin: 0 0 2rem;
  }

  .lede {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.15rem, 4.5vw, 1.35rem);
    line-height: 1.4;
    text-align: center;
    margin: 0 0 0.5rem;
  }

  .sub {
    text-align: center;
    font-size: 0.95rem;
    color: var(--coffee);
    line-height: 1.5;
    margin: 0 0 2rem;
  }

  .guess-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  button, .btn {
    font-family: 'Karla', sans-serif;
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--espresso);
    background: var(--cream);
    border: 1.5px solid var(--espresso);
    border-radius: 4px;
    padding: 0.9rem 1rem;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    display: block;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  button:hover, .btn:hover {
    background: var(--espresso);
    color: var(--cream);
  }

  button:focus-visible, .btn:focus-visible {
    outline: 2px solid var(--rose-deep);
    outline-offset: 2px;
  }

  .guess-grid button {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .divider {
    border: none;
    border-top: 1px solid var(--blush-deep);
    margin: 2rem 0;
  }

  .section-label {
    font-size: 0.95rem;
    text-align: center;
    margin: 0 0 0.9rem;
  }

  .btn-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .btn-primary {
    background: var(--rose-deep);
    border-color: var(--rose-deep);
    color: var(--cream);
    width: 100%;
    margin-top: 0.25rem;
  }

  .btn-primary:hover {
    background: var(--espresso);
    border-color: var(--espresso);
  }

  .coupon-card {
    border: 1.5px dashed var(--coffee-soft);
    border-radius: 6px;
    padding: 1.75rem 1.5rem;
    text-align: center;
  }

  .coupon-card .logo {
    max-width: 200px;
    margin-bottom: 1.5rem;
  }

  .coupon-code {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(2.2rem, 10vw, 2.8rem);
    letter-spacing: 0.03em;
    color: var(--rose-deep);
    margin: 0 0 0.5rem;
  }

  .coupon-offer {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
  }

  .coupon-note {
    font-size: 0.85rem;
    color: var(--coffee);
    margin: 0;
  }

  .coupon-count {
    font-size: 0.8rem;
    color: var(--coffee-soft);
    margin-top: 1.25rem;
  }

  .status-text {
    text-align: center;
    font-size: 1rem;
    color: var(--coffee);
    padding: 1rem 0;
  }

  .sold-out .lede {
    margin-bottom: 0.75rem;
  }
</style>
</head>
<body>

<main id="app">

  <!-- SCREEN 1: Guess -->
  <section id="screen-guess" class="screen active">
    <h1>Can you guess what's coming to this window?</h1>
    <div class="guess-grid">
      <button type="button" data-guess>Coffee Shop</button>
      <button type="button" data-guess>FroYo Shop</button>
      <button type="button" data-guess>Boutique</button>
      <button type="button" data-guess>Barber Shop</button>
    </div>
  </section>

  <!-- SCREEN 2: Reveal -->
  <section id="screen-reveal" class="screen">
    <img class="logo" src="data:image/png;base64," alt="Dave & Marbie's Cafe">
    <p class="lede">Good guess! It's Dave &amp; Marbie's Cafe &mdash; a FroYo shop and a coffee shop, all in one.</p>
    <hr class="divider">
    <p class="section-label">Tap to add our Grand Opening to your calendar</p>
    <div class="btn-row">
      <a class="btn" id="apple-cal-btn" href="grand-opening.ics">Apple</a>
      <a class="btn" id="google-cal-btn" href="#" target="_blank" rel="noopener">Google</a>
    </div>
    <hr class="divider">
    <p class="section-label">Tap here for your coupon</p>
    <button type="button" class="btn-primary" id="claim-btn">Claim my coupon</button>
  </section>

  <!-- SCREEN 3: Coupon -->
  <section id="screen-coupon" class="screen">
    <div id="coupon-content">
      <p class="status-text">Claiming your coupon&hellip;</p>
    </div>
  </section>

</main>

<script>
  // ---------------------------------------------------------------
  // EDIT THESE VALUES before publishing
  // ---------------------------------------------------------------
  const CONFIG = {
    eventName: "Dave & Marbie's Grand Opening",
    // All-day event: Google's "dates" param needs the day AFTER the
    // event as the end date. Keep these two lines in sync with the
    // date in grand-opening.ics if you change it.
    eventDateStart: "20270420",
    eventDateEnd: "20270421",
    eventDetails: "Come celebrate the grand opening of Dave & Marbie's Cafe -- FroYo and coffee on Main Street!",
    eventLocation: "200 Main St E, Suite 101, Menomonie, WI",

    // Paste your deployed Google Apps Script Web App URL here.
    // See the setup steps for the coupon counter.
    counterEndpoint: "PASTE_YOUR_APPS_SCRIPT_WEB_APP_URL_HERE", // TODO

    maxCoupons: 100,
    couponPrefix: "WS",
    couponOffer: "50% Off One Medium FroYo or Beverage"
  };
  // ---------------------------------------------------------------

  function showScreen(id) {
    document.querySelectorAll('.screen').forEach(function (el) {
      el.classList.remove('active');
    });
    document.getElementById(id).classList.add('active');
  }

  function buildGoogleCalendarUrl() {
    const params = new URLSearchParams({
      action: 'TEMPLATE',
      text: CONFIG.eventName,
      dates: CONFIG.eventDateStart + '/' + CONFIG.eventDateEnd,
      details: CONFIG.eventDetails,
      location: CONFIG.eventLocation
    });
    return 'https://calendar.google.com/calendar/render?' + params.toString();
  }

  document.getElementById('google-cal-btn').href = buildGoogleCalendarUrl();

  document.querySelectorAll('[data-guess]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      showScreen('screen-reveal');
    });
  });

  function renderCoupon(number) {
    const content = document.getElementById('coupon-content');

    if (number <= CONFIG.maxCoupons) {
      content.innerHTML =
        '<div class="coupon-card">' +
          '<img class="logo" src="data:image/png;base64," alt="Dave & Marbie\'s Cafe">' +
          '<p class="coupon-code">' + CONFIG.couponPrefix + number + '</p>' +
          '<p class="coupon-offer">' + CONFIG.couponOffer + '</p>' +
          '<p class="coupon-note">Show this screen at checkout.</p>' +
          '<p class="coupon-count">Coupon #' + number + ' of ' + CONFIG.maxCoupons + '</p>' +
        '</div>';
    } else {
      content.innerHTML =
        '<div class="sold-out">' +
          '<p class="lede">All coupons have been claimed.</p>' +
          '<p class="sub">See you at Grand Opening!</p>' +
        '</div>';
    }
  }

  function renderError() {
    document.getElementById('coupon-content').innerHTML =
      '<p class="status-text">Something went wrong claiming your coupon. Please try again.</p>' +
      '<button type="button" class="btn-primary" id="retry-btn">Try again</button>';
    document.getElementById('retry-btn').addEventListener('click', claimCoupon);
  }

  async function claimCoupon() {
    const stored = localStorage.getItem('dm_coupon_number');
    showScreen('screen-coupon');

    if (stored) {
      renderCoupon(parseInt(stored, 10));
      return;
    }

    document.getElementById('coupon-content').innerHTML =
      '<p class="status-text">Claiming your coupon&hellip;</p>';

    try {
      const res = await fetch(CONFIG.counterEndpoint);
      const data = await res.json();
      localStorage.setItem('dm_coupon_number', data.number);
      renderCoupon(data.number);
    } catch (err) {
      renderError();
    }
  }

  document.getElementById('claim-btn').addEventListener('click', claimCoupon);
</script>

</body>
</html>
